{
  "name": "is-web-y28-frontend-lectures",
  "private": true,
  "workspaces": ["examples/08-tooling-typescript"],
  "scripts": {
 "dev:01": "slidev slides/01-web-html.md --open",
 "dev:02": "slidev slides/02-css-basics.md --open",
 "dev:03": "slidev slides/03-css-layout.md --open",
 "dev:04": "slidev slides/04-modern-css.md --open",
 "dev:05": "slidev slides/05-css-organization.md --open",
 "dev:06": "slidev slides/06-javascript-browser.md --open",
 "dev:07": "slidev slides/07-javascript-state.md --open",
 "predev:08": "npm run build:ts-examples",
 "dev:08": "slidev slides/08-tooling-typescript.md --open",
 "dev:09": "slidev slides/09-vue-reactivity.md --open",
 "build": "npm run build:all",
 "build:01": "slidev build slides/01-web-html.md --out dist/01-web-html --without-notes",
 "build:02": "slidev build slides/02-css-basics.md --out dist/02-css-basics --without-notes",
 "build:03": "slidev build slides/03-css-layout.md --out dist/03-css-layout --without-notes",
 "build:04": "slidev build slides/04-modern-css.md --out dist/04-modern-css --without-notes",
 "build:05": "slidev build slides/05-css-organization.md --out dist/05-css-organization --without-notes",
 "build:06": "slidev build slides/06-javascript-browser.md --out dist/06-javascript-browser --without-notes",
 "build:07": "slidev build slides/07-javascript-state.md --out dist/07-javascript-state --without-notes",
 "prebuild:08": "npm run build:ts-examples",
 "build:08": "slidev build slides/08-tooling-typescript.md --out dist/08-tooling-typescript --without-notes",
 "build:09": "slidev build slides/09-vue-reactivity.md --out dist/09-vue-reactivity --without-notes",
 "prebuild:all": "npm run build:ts-examples",
 "build:all": "slidev build slides/*.md --out dist --without-notes",
 "build:pages": "node scripts/build-pages.mjs",
 "build:css-examples": "node scripts/build-css-examples.mjs",
 "dev:ts-examples": "npm run dev --workspace examples/08-tooling-typescript --",
 "check:ts-examples": "npm run check --workspace examples/08-tooling-typescript",
 "build:ts-examples": "node scripts/build-typescript-examples.mjs",
 "preview:ts-examples": "npm run preview --workspace examples/08-tooling-typescript --"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@slidev/cli": "^52.20.1",
    "@slidev/theme-default": "^0.25.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vue/compiler-dom": "^3.5.43",
    "autoprefixer": "^10.6.1",
    "bootstrap": "^5.3.8",
    "markdown-it": "^14.1.0",
    "playwright-chromium": "^1.63.0",
    "postcss": "^8.5.28",
    "sass": "^1.105.1",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@shikijs/core": "4.4.3",
    "@shikijs/engine-javascript": "4.4.3",
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "slidev-theme-tahta": "^0.10.7"
  }
}
